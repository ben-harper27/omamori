{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "packages/*/src",
    "scripts"
  ],
  "exclude": [
    "packages/dashboard"
  ]
}